# PostgreSQL
DB_HOST = "127.0.0.1"
DB_PORT = "5432"
DB_NAME = "secure_patrol"
DB_USERNAME = "postgres"
DB_PASSWORD = "password"
DB_SSLMODE = "disable"
DB_TIMEZONE = "Asia/Jakarta"
DB_LOG_LEVEL = "1"

PORT = "3000"

# development | staging | production
# API documentation (/docs) is only served when APP_ENV=development
APP_ENV = "development"

# Auto migrate always runs on startup.
# true  = seed roles, Super-Admin and dummy users on startup (idempotent)
# false = skip seeding
SEED_DUMMY_DATA = "false"
SEED_SUPER_ADMIN_EMAIL = "superadmin@securepatrol.local"
# Password for seeded users. Leave empty to generate one (printed once in the log).
SEED_DEFAULT_PASSWORD = ""

# Secrets, at least 32 characters. Generate with: openssl rand -base64 48
# APP_MASTER_SECRET must never change: it derives the App ID checksum and
# encrypts the stored app keys. Changing it invalidates every app client and
# changes the license Install ID (the installed license stops working).
JWT_SECRET = ""
APP_MASTER_SECRET = ""

# Real client IP behind a reverse proxy (used by the audit log and sessions).
# Set PROXY_HEADER (e.g. X-Forwarded-For) only behind a proxy, and list the proxy
# addresses in TRUSTED_PROXIES; otherwise clients could fake their IP.
PROXY_HEADER = ""
TRUSTED_PROXIES = ""

# Adjustable rules (patrol radius, offline window, face checks, login lockout, token
# lifetimes) are no longer read from this file. They are stored in the database
# (table system_settings), created with their defaults at startup, and changed by
# the Super-Admin through PUT /api/v1/settings.

# Business time zone for patrol shifts and dates (defaults to DB_TIMEZONE, then Asia/Jakarta)
APP_TIMEZONE = "Asia/Jakarta"

# Private folder for uploaded files (face photos). Never served statically.
STORAGE_PATH = "./storage"

# Optional. Used for the request nonce store (replay protection).
# Empty REDIS_HOST, or Redis unreachable, falls back to an in-memory store.
# The in-memory store only works for a single instance; use Redis when running more than one.
REDIS_HOST = "127.0.0.1"
REDIS_PORT = "6379"
REDIS_PASSWORD = ""

RABBITMQ_USERNAME = ""
RABBITMQ_PASSWORD = ""
RABBITMQ_HOST = ""
RABBITMQ_PORT = ""
RABBITMQ_VHOST = ""
